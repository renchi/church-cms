{
  "permissions": {
    "allow": [
      "Bash(npm install *)",
      "Bash(npx --version)",
      "Bash(ls /usr/local/bin/ | grep -E \"node|npm|pnpm\" && ls ~/.local/bin/ 2>/dev/null | grep -E \"node|npm|pnpm\")",
      "Read(//usr/local/bin/**)",
      "Read(//home/chito/.local/bin/**)",
      "Bash(pnpm install*)",
      "Bash(pnpm dev*)",
      "Bash(pnpm build*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm test*)",
      "Bash(pnpm format*)",
      "Bash(pnpm --filter*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose config*)",
      "Bash(docker ps*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-architecture.sh"
          }
        ]
      }
    ]
  }
}
