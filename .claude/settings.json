{
  "permissions": {
    "allow": [
      "Bash(npm install *)",
      "Bash(npx --version)",
      "Bash(gh pr *)",
      "Bash(git fetch *)",
      "mcp__claude_ai_Linear__save_issue",
      "mcp__claude_ai_Linear__get_issue",
      "Bash(gh issue *)",
      "Bash(git checkout *)",
      "Bash(git pull *)",
      "Skill(update-config)",
      "Skill(update-config:*)",
      "Bash(kubectl -n traefik get svc)",
      "Bash(kubectl -n traefik describe svc traefik)",
      "Bash(curl -s http://192.168.49.2:30950/api/members/health)",
      "Bash(kubectl -n traefik get pod -o jsonpath='{.items[0].spec.containers[0].args}')"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd /home/chito/church-cms && pnpm lint --silent 2>&1 | head -20"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '--- session ended ---'"
          }
        ]
      }
    ]
  }
}
