# Copy this file to .env.local and adjust as needed.
# .env.local is git-ignored; .env.example is committed as documentation.

# Base URL of the running members-service (no trailing slash). Read only by
# server-side code (lib/membersApi.ts), so no NEXT_PUBLIC_ prefix: that prefix
# would copy the value into the JavaScript sent to the browser.
MEMBERS_API_URL="http://localhost:3001"
