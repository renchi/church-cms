generator client {
  provider = "prisma-client-js"
  // Generate into THIS service's folder, not the default
  // node_modules/.prisma/client: pnpm keeps one shared copy of @prisma/client
  // for the whole monorepo, so both services would otherwise generate into the
  // same folder and overwrite each other's client. Code imports it from
  // src/infrastructure/prisma.ts. Git-ignored. (events-service does the same.)
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  // Identity is generated by the domain (Member aggregate), not the database.
  id              String    @id
  name            String
  email           String    @unique
  phone           String?
  status          String    @default("active")
  // Attendance summary, copied from the Events context's AttendanceRecorded
  // messages (see Member.recordAttendance). Events owns attendance; this is a
  // read-only copy so a member's profile can show it without calling Events.
  attendanceCount Int       @default(0)
  lastAttendedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  // Optimistic locking (see PrismaMemberRepository.save). Stored rows start at
  // 1; 0 only ever exists in memory, for a member never saved. The default is
  // 1, not 0, so rows that existed before this column are "saved", not "new".
  version         Int       @default(1)
}

// The transactional outbox (ADR-0010). A use case that must announce
// something to another context writes a row here IN THE SAME TRANSACTION as
// the aggregate it changed. The outbox relay (src/infrastructure/messaging.ts)
// later publishes each row to NATS and sets publishedAt.
model OutboxMessage {
  id          String    @id // the message id; also sent as the Nats-Msg-Id header
  subject     String // the NATS subject, e.g. cms.members.archived
  payload     Json // the wire event from @cms/events
  createdAt   DateTime  @default(now())
  publishedAt DateTime? // null = not published yet
  // W3C trace context of the request that wrote this row (CMS-29). The relay
  // publishes later, outside that request, and continues its trace from here.
  // null = written while tracing was off, or before this column existed.
  traceparent String?

  // The relay's query: unpublished rows, oldest first.
  @@index([publishedAt, createdAt])
}

// Message ids this service has already processed (ADR-0010). JetStream
// delivers at least once, so the same message can arrive twice. The consumer
// inserts the id in the same transaction as its change; a second delivery
// finds the id already here and changes nothing. This makes it idempotent.
model ProcessedMessage {
  id          String   @id
  processedAt DateTime @default(now())
}
