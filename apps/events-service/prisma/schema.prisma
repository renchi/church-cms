generator client {
  provider = "prisma-client-js"
  // Generate into THIS service's folder instead of the default
  // node_modules/.prisma/client. pnpm keeps one shared copy of @prisma/client
  // for the whole monorepo, so with the default both services would generate
  // into the same folder, and whichever ran `prisma generate` last would
  // overwrite the other's client (members-service then fails typecheck with
  // "Property 'member' does not exist"). Code imports it from
  // ../generated/client (see src/infrastructure/prisma.ts). Git-ignored.
  output   = "../generated/client"
}

// The Events context's OWN database (ADR-0008: one Postgres per service).
// Members live in a different database, so `memberId` / `ministerId` below are
// plain strings: no foreign key can point across databases, and that is the
// point. The anti-corruption layer holds at the storage level too.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ServiceEvent {
  // Identity is generated by the domain (ServiceEvent aggregate), not the database.
  id              String   @id
  title           String
  eventType       String // "service" | "event"
  // The Venue value object is stored "flattened" into three columns. A value
  // object has no identity of its own, so it needs no table of its own.
  venueName       String
  venueAddress    String?
  venueIsOnline   Boolean  @default(false)
  ministerId      String? // a Member's id (Members context), never a Member row
  scheduledAt     DateTime
  durationMinutes Int
  status          String   @default("scheduled")
  description     String?
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  // Optimistic locking (see PrismaServiceEventRepository.save). Stored rows
  // start at 1; 0 only ever exists in memory, for an event never saved.
  version         Int      @default(1)

  // Foreign keys INSIDE this context are fine: all three tables live in the
  // same database and belong to the same bounded context.
  attendances          Attendance[]
  volunteerAssignments VolunteerAssignment[]

  // "List upcoming events" filters and sorts on these two columns.
  @@index([status, scheduledAt])
}

model Attendance {
  id            String       @id
  eventId       String
  event         ServiceEvent @relation(fields: [eventId], references: [id])
  memberId      String // a Member's id (Members context)
  checkedInAt   DateTime
  checkedInById String
  method        String // "self" | "manual" | "qr_code"

  // ADR-0004 invariant: one Attendance per member per event. The use case
  // checks first (for a friendly 409); this constraint is the backstop when
  // two check-ins race each other.
  @@unique([eventId, memberId])
}

model VolunteerAssignment {
  id           String       @id
  eventId      String
  event        ServiceEvent @relation(fields: [eventId], references: [id])
  memberId     String // a Member's id (Members context)
  role         String
  assignedById String
  assignedAt   DateTime
  confirmedAt  DateTime?
  status       String       @default("pending")

  // ADR-0004 invariant: one assignment per member per ROLE per event. The same
  // member may still hold two different roles in one event.
  @@unique([eventId, memberId, role])
}

// The transactional outbox (ADR-0010). RecordAttendanceUseCase saves the
// Attendance and an AttendanceRecorded row here IN ONE TRANSACTION; the outbox
// relay (src/infrastructure/messaging.ts) then publishes it to NATS and sets
// publishedAt. Named "Message", not "Event": in this context "event" already
// means a church service or event.
model OutboxMessage {
  id          String    @id // the message id; also sent as the Nats-Msg-Id header
  subject     String // the NATS subject, e.g. cms.events.attendance.recorded
  payload     Json // the wire event from @cms/events
  createdAt   DateTime  @default(now())
  publishedAt DateTime? // null = not published yet

  // The relay's query: unpublished rows, oldest first.
  @@index([publishedAt, createdAt])
}

// Message ids already processed (ADR-0010). JetStream delivers at least once;
// the consumer inserts the id in the same transaction as its change, so a
// second delivery of MemberArchived changes nothing.
model ProcessedMessage {
  id          String   @id
  processedAt DateTime @default(now())
}
